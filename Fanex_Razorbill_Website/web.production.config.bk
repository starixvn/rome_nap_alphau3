  <system.webServer>
    <modules>
      <add name="TplCore" type="TplCore.Web.HttpHeaderModule"/>
    </modules>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="30000000" maxUrl="260" maxQueryString="30000000"/>
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="" overrideMode="Deny">
    <system.webServer/>
  </location>
  <location path="" overrideMode="Allow">
    <system.webServer>
      <urlCompression/>
    </system.webServer>
  </location>
</configuration>