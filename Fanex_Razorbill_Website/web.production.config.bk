<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="IBCAgent" type="ConfigSection.IBCAccounting, __code"/>
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
    <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Microsoft.Practices.Unity.Configuration, Version=2.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    <section name="Sunplus.Bingo" type="Sunplus.Bingo.Core.Configuration.BingoConfigurationSection, Sunplus.Bingo.Core"/>
    <!--Live Casino-->
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    <!--/Live Casino-->
    <!--For NewPT-->
    <section name="PTMappingSection" type="Fanex.PTEngine.XmlMapping.PTMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <section name="BettingLimitMappingSection" type="Fanex.PTEngine.XmlMapping.BettingLimitMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <!--/For NewPT-->
  </configSections>
  <!--For NewPT-->
  <PTMappingSection configSource="PTEngine\PTMappingSection.config"/>
  <BettingLimitMappingSection configSource="PTEngine\BettingLimitMappingSection.config"/>
  <!--/For NewPT-->
  <!--Live Casino-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/SpNames.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.40.40.79\private$\entlib" defaultCategory="Agency"/>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <!--/Live Casino-->
  <Sunplus.Bingo>
    <BingoGame EnabledMaxTransfer="true" CodeGameNo="01"/>
    <NumberGame Enabled="false"/>
  </Sunplus.Bingo>
  <unity>
    <typeAliases>
      <!-- Lifetime manager types -->
      <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <typeAlias alias="external" type="Microsoft.Practices.Unity.ExternallyControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <!-- Custom object types -->
      <typeAlias alias="ICustomerService" type="Sunplus.Bingo.Services.ICustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="CustomerService" type="Sunplus.Bingo.Services.CustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="IReportService" type="Sunplus.Bingo.Services.IReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ReportService" type="Sunplus.Bingo.Services.ReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ICustomerDAO" type="Sunplus.Bingo.Data.ICustomerDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="EntlibCustomerDAO" type="Sunplus.Bingo.Data.Entlib.EntlibCustomerDAO, Sunplus.Bingo.Data.Entlib"/>
      <typeAlias alias="IReportDAO" type="Sunplus.Bingo.Data.IReportDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="LinqCustomerDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqCustomerDAO, Sunplus.Bingo.Data.LinqToSql"/>
      <typeAlias alias="LinqReportDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqReportDAO, Sunplus.Bingo.Data.LinqToSql"/>
    </typeAliases>
    <containers>
      <remove name="BingoContainer"/>
      <container name="BingoContainer">
        <types>
          <type type="ICustomerService" mapTo="CustomerService"/>
          <type type="IReportService" mapTo="ReportService"/>
          <type type="ICustomerDAO" mapTo="LinqCustomerDAO"/>
          <type type="IReportDAO" mapTo="LinqReportDAO"/>
        </types>
      </container>
    </containers>
  </unity>
  <nlog autoReload="true" throwExceptions="true">
    <targets async="true">
      <target name="shared_cache_general" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_general_log.txt"/>
      <target name="shared_cache_traffic" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_traffic_log.txt"/>
      <target name="shared_cache_tracking" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_tracking_log.txt"/>
      <target name="shared_cache_sync" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_sync_log.txt"/>
    </targets>
    <rules>
      <logger name="General" minlevel="Debug" writeTo="shared_cache_general" final="true"/>
      <logger name="Traffic" minlevel="Debug" writeTo="shared_cache_traffic" final="true"/>
      <logger name="Tracking" minlevel="Debug" writeTo="shared_cache_tracking" final="true"/>
      <logger name="Sync" minlevel="Debug" writeTo="shared_cache_sync" final="true"/>
      <logger name="*" minlevel="Debug" writeTo="shared_cache_general"/>
      <logger name="*" minlevel="Info" writeTo="shared_cache_general"/>
    </rules>
  </nlog>
  <IBCAgent>
    <Bingo providerType="DAL.Provider.Bingo.BingoProviderClient" showBetSetting="false"/>
    <Casino providerType="DAL.APIClient.APICasinoProvider" showBetSetting="false"/>
    <IBCCustomer providerType="DAL.IBCClient.IBCLibProvider"/>
  </IBCAgent>
  <appSettings/>
  <connectionStrings>
