<?xml version="1.0"?>
<ReportTimeRangeSection system="Alpha">
    <reportUrl>
        <!--1. From the latest BalanceUp date-->
        <add url="/_Reports/MatchWinloss/MatchWinLoss.aspx,
             /_Reports/MatchWinloss/MatchWinLossDetail.aspx,
             /_Reports/Common/SelectLeagues.aspx,
             /_Reports/Winloss/WinLossByBettypeSuper.aspx,
             /_Reports/Winloss/WinLossByBettypeMaster.aspx,
             /_Reports/Winloss/WinLossByBettypeAgent.aspx,
             /Report/CommissionByBetType,
             /_Reports/Commission/HRCommission.aspx,
             /_Reports/Result/Result.aspx"
             
             rpttype="1" />
      
        <!--2. First day of previous 3 Months-->
        <add url="/_Reports/Common/MatchResultEntered.aspx,
             /_Reports/Winloss/WinlossSuper.aspx,
             /_Reports/Winloss/WinlossMaster.aspx,
             /_Reports/Winloss/WinlossAgent.aspx,
             /_Reports/Winloss/WinLossDetailSuper.aspx,
             /_Reports/Winloss/WinLossDetailMaster.aspx,
             /_Reports/Winloss/WinLossDetailAgent.aspx,
             /_Reports/BetList/OutstandingDetail.aspx,
             /Finance/StatementMember,
             /_Reports/CasinoWinloss/CSWinlossSuper.aspx,
             /_Reports/CasinoWinloss/CSWinlossMaster.aspx,
             /_Reports/CasinoWinloss/CSWinlossAgent.aspx,
             /_Reports/CasinoWinloss/CSWinlossDetailSuper.aspx,
             /_Reports/CasinoWinloss/CSWinlossDetailMaster.aspx,
             /_Reports/CasinoWinloss/CSWinlossDetailAgent.aspx,
             /_Reports/BingoWinloss/BingoWinlossSuper.aspx,
             /_Reports/BingoWinloss/BingoWinlossMaster.aspx,
             /_Reports/BingoWinloss/BingoWinlossAgent.aspx,
             /_Reports/BingoWinloss/BingoWinlossDetailSuper.aspx,
             /_Reports/BingoWinloss/BingoWinlossDetailMaster.aspx,
             /_Reports/BingoWinloss/BingoWinlossDetailAgent.aspx" 
             
             rpttype="2" />
        
        <!--3. From 05/20/2013 (special case for report FB Financial)-->
        <add url="/Report/Foobet" 
             
             rpttype="3" />
      
        <!--4. First date of previous 18 Months-->
        <add url="/_Reports/WinlossAnalysis/Daily_WinlossAnalysisSuper.aspx,
             /_Reports/WinlossAnalysis/Daily_WinlossAnalysisMaster.aspx,
             /_Reports/WinlossAnalysis/Daily_WinlossAnalysisAgent.aspx,
             /_Reports/WinlossAnalysis/Monthly_WinlossAnalysisSuper.aspx,
             /_Reports/WinlossAnalysis/Monthly_WinlossAnalysisMaster.aspx,
             /_Reports/WinlossAnalysis/Monthly_WinlossAnalysisAgent.aspx,
             /_Reports/WinlossAnalysis/Sport_WinlossAnalysisSuper.aspx,
             /_Reports/WinlossAnalysis/Sport_WinlossAnalysisMaster.aspx,
             /_Reports/WinlossAnalysis/Sport_WinlossAnalysisAgent.aspx,
             /Report/Consolidate,
             /_Charts/WinlossAnalysis/MonthlyAgent.aspx" 
             
             rpttype="4" />
      
        <!--5. First date of first month of previous 3 Years-->
        <add url="/_Reports/Winloss/WinlossSuperHistory,
             /_Reports/Winloss/WinlossMasterHistory,
             /_Reports/Winloss/WinlossAgentHistory,
             /_Reports/Winloss/WinlossDetailSuperHistory,
             /_Reports/Winloss/WinlossDetailMasterHistory,
             /_Reports/Winloss/WinlossDetailAgentHistory,
             /Finance/StatementSMAHistory,
             /Finance/StatementSMA" 
             
             rpttype="5" />
    </reportUrl>
</ReportTimeRangeSection>