<%@ Master Language="C#" EnableViewState="false" AutoEventWireup="false" CodeFile="ViewLog.master.cs" Inherits="Sunplus.Agent.UI._ViewLog.ViewLog_Page" %>

<%@ Import Namespace="Sunplus.Agent.UI" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>View log</title>
    <link href="../../_GlobalResources/Css/Agent.css" rel="stylesheet" type="text/css" />
    <link href="../../_GlobalResources/Css/Tab.css" rel="stylesheet" type="text/css" />
    <link href="../../_GlobalResources/Css/Table.css" rel="stylesheet" type="text/css" />
    <link href="../../_GlobalResources/Css/Paging.css" rel="stylesheet" type="text/css" />
    <link href="../../_ViewLog/Resources/ViewLog.css" rel="stylesheet" type="text/css" />
    <link href="../_Components/DateTimeControl/JSCalendar/css/jscal2.css" rel="stylesheet" type="text/css" />
    <link href="../_Components/DateTimeControl/JSCalendar/css/steel/steel.css" rel="stylesheet" type="text/css" />
    <link href="../_AccountInfo/Resources/styles.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1" runat="server">
    <div id="page_main">
        <div>
            <div id="button_hr">
                <div id="tab_hr">
                    <ul>
                        <% if (this.VisibleMenuItem)
                           {%>
                        <li id="CustomerSetting">
                        <a href="javascript:MenuGoTo('CustomerSetting')"><span>
                            <asp:Literal ID="Literal2" Text="<%$ Resources:ViewLog, defaultlog %>" EnableViewState="false" runat="server" />
                        </span>
                        </a>
                        </li>
                        <li id="Status">
                        <a href="javascript:MenuGoTo('Status')"><span>
                            <asp:Literal ID="Literal3" Text="<%$ Resources:ViewLog, statuslog %>" EnableViewState="false" runat="server" /></span> </a></li>
                        <li id="Credit">
                        <a href="javascript:MenuGoTo('Credit')"><span>
                            <asp:Literal ID="Literal4" Text="<%$ Resources:ViewLog, creditlog %>" EnableViewState="false" runat="server" />
                        </span>
                        </a>
                        </li>
                        <%}%>
                        <li id="Login">
                        <a href="javascript:MenuGoTo('Login')"><span>
                            <asp:Literal ID="Literal5" Text="<%$ Resources:ViewLog, loginlog %>" EnableViewState="false" runat="server" />
                        </span>
                        </a>
                        </li>
                    </ul>
                </div>
            </div>
            <%--Search banner--%>
            <div id="box_header" style="border-top: 0px; padding: 5px 5px 5px 5px;">
                <div class="divUserName">
                    <div class="divSearch" id="divUserName" runat="server">
                        <asp:Literal ID="Literal6" Text="<%$ Resources:Lang, UserName %>" runat="server"></asp:Literal>
                        <input maxlength="50" id="txtUserName" name="txtUserName" class="username" type="text" style="width: 150px" title='<%= Resources.Lang.enterusername %>' onkeydown='onclickUser("<%= Resources.Lang.enterusername %>")' onfocus='onclickUser("<%= Resources.Lang.enterusername  %>")' onblur='onblurUser("<%= Resources.Lang.enterusername %>")' onkeypress='KeyPress(event)' autocomplete="off" />
                        <span id="RequiredUserName" class="required">*</span>
                    </div>
                    <div class="divLogType" id="ddlLogActionType">
                        <asp:Literal ID="Literal9" Text="<%$ Resources:ViewLog, viewby %>" runat="server"></asp:Literal>
                        <asp:DropDownList CssClass="ActionType" onChange="DoSearch();" ID="ddlActionType" runat="server" EnableViewState="false">
                        </asp:DropDownList>
                    </div>
                    <asp:Literal ID="ltrDate" runat="server"></asp:Literal>
                    <div id="divShowOldValue">
                        <input type="checkbox" value="true" id="chk_showOldValue" onchange="setShowOldValueCookie(this)" />
                        <label for="chk_showOldValue"><%= Resources.Viewlog.showOldValue %></label>
                    </div>
                </div>
            </div>
            <div class="warning" id="divMessageWarning" style="display: none">
                <ul>
                    <li>
                        <asp:Literal ID="Literal10" Text="<%$ Resources:ViewLog, login_message_log %>" runat="server"></asp:Literal>
                    </li>
                </ul>
            </div>
            <asp:ContentPlaceHolder ID="contentData" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </div>
    </form>

    <script src="../../_GlobalResources/Js/Core.js?<%=Sunplus.Agent.Model.BL.Definitions.AppSettings.JsVersion%>" type="text/javascript"></script>

    <script src="../../_Components/AGEWnd/AGEWnd.js?<%=Sunplus.Agent.Model.BL.Definitions.AppSettings.JsVersion%>" type="text/javascript"></script>

    <script src="../_AccountInfo/Resources/autocomplete.js" type="text/javascript"></script>

    <script src="Resources/ViewLogLibs.js?<%=Sunplus.Agent.Model.BL.Definitions.AppSettings.JsVersion%>" type="text/javascript"></script>

    <script type="text/javascript" language="javascript">
        var ctrInput = "<%=DateTime.Now.ToString()%>";
        var ddlActionType = '<%=ddlActionType.ClientID%>';
        var role = '<%= Sunplus.Agent.Model.Entities.UserSession.Current.RoleId %>';
        var enterusername = '<%=HttpContext.GetGlobalResourceObject("Lang", "enterusername")%>';
        RegisterStartUp('Initialize()');
    </script>

    <div class="shadow" id="shadow" />
    <div class="output" id="output" />
</body>
</html>
