@using Resources = Fanex.BetListDetail.Lucky3.Resources.Resource
@using Fanex.BetListDetail.Lucky3.ViewModels


@model Lucky3DetailViewModel

<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter tblRpt-hover tbl-betlist">
    <thead>
        <tr>
            <th>
                <div class="col-number">
                    @Resources.Number
                </div>
            </th>
            <th>
                <div class="col-transtime">
                    @Resources.Hits
                </div>
            </th>
            <th>
                <div class="col-odds">
                    @Resources.Bets
                </div>
            </th>
            <th>
                <div class="col-stake">
                    @Resources.Prize
                </div>
            </th>
            <th>
                <div class="col-stake">
                    @Resources.Stake
                </div>
            </th>
            <th>
                <div class="col-winloss">
                    @Resources.Winloss

                </div>
            </th>
            @if (Model.IsSuper)
            {
                <th>
                    <div class="col-pt">
                        @Resources.SuperComm
                    </div>
                </th>
            }
            @if (Model.IsSuper || Model.IsMaster)
            {
                <th>
                    <div class="col-pt">
                        @Resources.MasterComm
                    </div>
                </th>
            }
            @if (Model.IsAgent || Model.IsMaster || Model.IsSuper)
            {
                <th>
                    <div class="col-pt">
                        @Resources.AgentComm
                    </div>
                </th>
            }

            <th>
                <div class="col-status">
                    @Resources.Status
                </div>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Details.Any())
            {
                foreach (var ticket in Model.Details)
                {
                <tr>
                    <td>@ticket.TransactionDescription</td>
                    <td>@ticket.Hits</td>
                    <td>@ticket.Bets</td>
                    <td>@Model.FormatMoney(ticket.Prize)</td>
                    <td>@Model.FormatMoney(ticket.Stake)</td>
                    <td>@Model.FormatWinLost(ticket.Winlost)</td>
                    @if (Model.IsSuper)
                    {
                        <td>@Model.FormatDiscount(ticket.SuperDiscount) <br /> @Model.FormatMoney(ticket.SuperCommission)</td>
                    }
                    @if (Model.IsSuper || Model.IsMaster)
                    {
                        <td>@Model.FormatDiscount(ticket.MasterDiscount) <br /> @Model.FormatMoney(ticket.MasterCommission)</td>
                    }
                    @if (Model.IsAgent || Model.IsMaster || Model.IsSuper)
                    {
                        <td>@Model.FormatDiscount(ticket.AgentDiscount) <br /> @Model.FormatMoney(ticket.AgentCommission)</td>
                    }

                    <td>@ticket.Status</td>
                </tr>
            }
            <tr>
                <td colspan="4">@Resources.TotalLost</td>
                <td>10.00</td>
                <td>-10.00</td>
                @if (Model.IsSuper)
                {
                    <td>10% <br /> 0.5</td>
                }
                @if (Model.IsSuper || Model.IsMaster)
                {
                    <td>5% <br /> 0.3</td>
                }
                @if (Model.IsAgent || Model.IsMaster || Model.IsSuper)
                {
                    <td>3% <br /> 0.2</td>
                }

                <td>Lose</td>
            </tr>
            <tr>
                <td colspan="5">@Resources.Total</td>
                <td>@Model.FormatWinLost(Model.TotalWinlost)</td>
                @if (Model.IsSuper)
                {
                    <td>@Model.FormatMoney(Model.TotalSuperCommission)</td>
                }
                @if (Model.IsSuper || Model.IsMaster)
                {
                    <td>@Model.FormatMoney(Model.TotalMasterCommission)</td>
                }
                @if (Model.IsAgent || Model.IsMaster || Model.IsSuper)
                {
                    <td>@Model.FormatMoney(Model.TotalAgentCommission)</td>
                }

                <td></td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="@Model.TotalColumns" class="text-center">@Resources.NoData</td>
            </tr>
        }
    </tbody>
</table>


