	<ONEbook.UM ServiceUris="http://ha.nexdev.net:8889/api" EnableCheckUM="true" UMAddress="tcp://10.40.40.150:8990/UMControllerInterface" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/Account/Offline">
		<AllowedIPs AllowAll="true" />
	</ONEbook.UM>
