  <SpamFilterConfiguration configSource="Web.Configuration\SpamFilter.config" />
  <SecurityCodeSection configSource="Web.Configuration\SecurityCode.config" />
  <ReportTimeRangeSection configSource="Web.Configuration\ReportTimeRange.config" />
  <KenoBetTypesSection configSource="Web.Configuration\KenoBetTypesSection.config" />
