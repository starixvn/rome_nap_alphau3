  <RnGCasinoSection configSource="Web.Configuration\RnGCasino.config" />
  <!--mapping report-->
  <couchbase>
    <servers bucket="Agency" bucketPassword="">
      <add uri="http://10.18.200.202:8091/pools/default" />
      <add uri="http://10.18.200.207:8091/pools/default" />
      <add uri="http://10.18.200.210:8091/pools/default" />
    </servers>
  </couchbase>
  <ProgressiveSection active="false" system="2">
    <Product>
      <add id="72" name="Progressive" active="true" />
      <add id="73" name="Enable progressive test 1" active="false" />
      <add id="74" name="Enable progressive test 2" active="false" />
    </Product>
  </ProgressiveSection>
  <CurrentSession sessionFactory="Fanex.CustomerSetting.Module.Core.Web.CurrentSession, Fanex.CustomerSetting.Module.Core" />
