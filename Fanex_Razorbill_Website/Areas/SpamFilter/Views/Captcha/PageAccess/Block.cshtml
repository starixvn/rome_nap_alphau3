
@model Fanex.Security.Captcha.ViewModels.PageInfo


var Captcha ={
    PageName:'@Model.PageName',
    RootURL:location.protocol + '//' + location.host + '@Url.Content("~/")'
}
var errorHTML = "<iframe src='" + Captcha.RootURL + "SpamFilter/BlockPage/Index?pagename=" + Captcha.PageName + "' frameborder='0' width='100%' height='100%' scrolling='no' id='frBlockPage' name='frBlockPage' style='position:fixed; left:0; top: 0; '></iframe>";

  var eleError = document.createElement('div');
  eleError.innerHTML = '"' + errorHTML + "'";
  
  document.body.onload = function()
{
    document.body.appendChild(eleError);
}

