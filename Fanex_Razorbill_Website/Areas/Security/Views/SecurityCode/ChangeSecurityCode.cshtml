@{
    ViewBag.Title = "ChangeSecurityCode";
    Layout = "~/Areas/Security/Views/Shared/_Layout.cshtml";
}
@section js {
    @System.Web.Optimization.Scripts.Render("~/bundles/changesecuritycode-js")
    <script type="text/javascript">
        var securityCodeToken = '@ViewBag.SecurityCodeToken';
        var securitySalt = '@ViewBag.SecuritySalt';
        var securityCodeResource = {
            alertOldSecCodeEmpty: '@Fanex.Razorbill.Security.Resources.Lang.alertOldSecCodeEmpty',
            alertSecCodeEmpty: '@Fanex.Razorbill.Security.Resources.Lang.alertSecCodeEmpty',
            alertSecCodeWrongRule: '@Fanex.Razorbill.Security.Resources.Lang.lblSecCodeWrongRule',
            alertErrorSecCodeConfirm: '@Fanex.Razorbill.Security.Resources.Lang.alertErrorSecCodeConfirm',
            alertSameSecCode: '@Fanex.Razorbill.Security.Resources.Lang.alertSameSecCode',
            alertSecCodeSucc: '@Fanex.Razorbill.Security.Resources.Lang.alertSecCodeChangedOK'
        };
    </script>
}
<div class="container-wrap">
    <div class="header_wrap">
        <a href="javascript:changesecuritycode.gotoPwdPage()">@Fanex.Razorbill.Security.Resources.Lang.Password</a>
        |
        @Fanex.Razorbill.Security.Resources.Lang.SecurityCode
    </div>
    <br />
    @using (Html.BeginForm("ChangeSecurityCode", "SecurityCode", System.Web.Mvc.FormMethod.Post,
                             new { id = "frmChangeSecurityCode" }))
    {
        @Html.Partial("../Shared/_HeaderMessage", null)
        <table class="content-wrap width370" cellspacing="1" cellpadding="0">
            <tr>
                <td colspan="2" class="header bg_eb">@Fanex.Razorbill.Security.Resources.Lang.SecurityCode</td>
            </tr>
            <tr class="bg_eb">
                <td class="left-align widthPercent40">@Fanex.Razorbill.Security.Resources.Lang.oldSecCode</td>
                <td class="left-align">
                    <input id="txtOldSecCode" type="password" name="oldSecurityCode" autocomplete="off" maxlength="6" />
                </td>
            </tr>
            <tr class="bg_eb">
                <td class="left-align widthPercent40">@Fanex.Razorbill.Security.Resources.Lang.SecurityCode</td>
                <td class="left-align">
                    <input id="txtSecCode" onkeyup="return validateSecurityCode(this,'spnSecCodeIcon');" type="password" name="securityCode" autocomplete="off" maxlength="6" />
                    <span id="spnSecCodeIcon" class="">&nbsp;</span>
                </td>
            </tr>
            <tr class="bg_eb">
                <td class="left-align">@Fanex.Razorbill.Security.Resources.Lang.ConfirmSecurityCode</td>
                <td class="left-align">
                    <input id="txtConfirmSecCode" onkeyup="return validateSecurityCode(this,'spnConfirmSecCodeIcon');" type="password" name="confirmSecurityCode" autocomplete="off" maxlength="6" />
                    <span id="spnConfirmSecCodeIcon" class="">&nbsp;</span>
                </td>
            </tr>
            <tr>
                <td class="bg_eb center-align" colspan="2">
                    <input type="submit" value="@Fanex.Razorbill.Security.Resources.Lang.Submit" class="btn" />
                    <input type="reset" value="@Fanex.Razorbill.Security.Resources.Lang.Reset" class="btn" />
                </td>
            </tr>
        </table>
    }
    @Html.Partial("../Shared/_SecurityCodeHint", Fanex.Razorbill.Security.Resources.Lang.lblRequiredSecCode)
    <div class="learn-more width370">
        <hr size="1" />
        @Html.ActionLink(Fanex.Razorbill.Security.Resources.Lang.LearnMore, "HowToUse", "SecurityCode", null, new { style = "padding:4px", target = "_blank" })
    </div>
</div>