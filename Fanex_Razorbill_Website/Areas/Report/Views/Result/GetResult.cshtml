@using Sunplus.Agent.Model.Entities;
@using Fanex.Razorbill.Module.Common.Helpers;
@model Fanex.Razorbill.Module.Report.Entities.ResultRequest
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Html.Raw(ViewBag.ResultTitle)</title>
    <link href="../../_GlobalResources/Css/Agent.css" rel="stylesheet" type="text/css" />
    <link href="../../_Reports/Resources/Reports.css" rel="stylesheet" type="text/css" />
    <link href="../../_BetList/Resources/BetList.css" rel="stylesheet" type="text/css" />
    <link href="../../Content/Fanex.Result/fanex.result.css" rel="stylesheet" type="text/css" />
    <link href="../../Content/Fanex.Result/fanex.result-customized.css" rel="stylesheet"
        type="text/css" />
    <link href="@Url.Content("~/_Components/DateRangeSelect/DateRangeSelect.css")"
        rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/_Components/DateTimeControl/JSCalendar/css/jscal2.css?06")"
        rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/_Components/DateTimeControl/JSCalendar/css/steel/steel.css?06")"
        rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="frmmain" method="get">
    <div id="page_main">
        <!--ResultTitle-->
        @if (ViewBag.IsVisibleResultTitle == true)
        {
            <div id="header_main" style="float: left; width: 95%;">
                <div style="float: left;">@Html.Raw(ViewBag.ResultTitle)</div>
                <div style="float: right; width: 60%; text-align: right; margin-right: 15px;">
                    @if (UserSession.Current.IsShowSportbook)
                    { 
                        <input @ViewBag.DisabledNormal  type="button" class="btn @ViewBag.DisabledNormalClass" style="width: 65px; margin-right: 5px;" id="btnNormal" value="@ViewBag.NormalResultTitle" />
                        <input @ViewBag.DisabledOutright  type="button" class="btn @ViewBag.DisabledOutrightClass" style="width: 65px; margin-right: 5px;" id="btnOutRight" value="@ViewBag.OutrightResultTitle" />
                        <!--KenoTitle-->
                        if (ViewBag.HideKenoTitle == false && !IPHelper.IsWebVpnAccess())
                        {
                        <input type="button" class="btn" style="width: 65px; margin-right:5px;" id="btnKeno" value="@ViewBag.KenoResult" onclick="location.href='@ViewBag.KenoURL'"/>
                        }
                        <!--/KenoTitle-->
                    }
                </div>
            </div>
        }
        <!--/ResultTitle-->
        <table cellspacing="0" cellpadding="0" border="0" width="100%">
            <!--HeaderRegion-->
            @if (ViewBag.IsVisibleHeaderRegion == true)
            {
                <tr>
                    <td>
                        <div id="box_header">
                            <table style="width: 100%">
                                <tr>
                                    <td>
                                        <div id="spDateTimeSearch">
                                            <table cellpadding="0" cellspacing="0" border="0">
                                                <tr>
                                                    <td id="tdfdatetext" style="padding-left: 6px;" class="l">
                                                        <span id="spfdatetext">@Resources.Lang.from:</span>
                                                    </td>
                                                    <td id="tdFromDateCal" class="l">
                                                        <span id="spFromDateCal">
                                                            <table cellpading="0" cellspacing="0" border="0">
                                                                <tr>
                                                                    <td>
                                                                        <input id="fromDate" name="fromDate" class="date_no" value="@DateTime.Now.ToShortDateString()" type="text"
                                                                size="13" readonly="readonly" />
                                                                    </td>
                                                                    <td>
                                                                        <input type="image" alt="" src="@Url.Content("~/_GlobalResources/Images/cal.gif")"
                                                                        id="fdate_trigger" title="Date selector" style="margin: 0px; cursor: pointer"
                                                                        onclick="javascript:return false;" /><!-- <img alt="" src="/Fanex.Razorbill.Website/_GlobalResources/Images/cal.gif" id="fdate_trigger" title="Date selector"style="margin: 0px; cursor: pointer" /> -->
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </span>
                                                    </td>
                                                    <td id="tdtdatetext" class="l">
                                                        &nbsp;&nbsp; <span id="sptdatetext">@Resources.Lang.to:</span>
                                                    </td>
                                                    <td id="tdToDateCal" class="l">
                                                        <span id="spToDateCal">
                                                            <table cellpading="0" cellspacing="0" border="0">
                                                                <tr>
                                                                    <td>
                                                                        <input id="toDate" name="toDate" class="date_no" value="@DateTime.Now.ToShortDateString()" type="text" size="13"
                                                                     readonly="readonly" />
                                                                    </td>
                                                                    <td>
                                                                        <input type="image" alt="" src="@Url.Content("~/_GlobalResources/Images/cal.gif")"
                                                                            id="tdate_trigger" title="Date selector" style="margin: 0px; cursor: pointer"
                                                                            onclick="javascript:return false;" /><!-- <img alt="" src="/Fanex.Razorbill.Website/_GlobalResources/Images/cal.gif" id="tdate_trigger" title="Date selector"style="margin: 0px; cursor: pointer" /> -->
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </span>
                                                    </td>
                                                    <td class="l">
                                                        &nbsp;&nbsp;<input type="button" class="btn" style="width: 55px" id="dSubmit" value="@Resources.Lang.submit"/>
                                                        <input type="button" id="dToday" class="btn" style="width: 80px" value="@DateTime.Now.ToShortDateString()"/>
                                                        <input type="button" id="dYesterday" class="btn" style="width: 80px" value="@DateTime.Now.AddDays(-1).ToShortDateString()"/>
                                                    </td>
                                                    <td valign="top">
                                                        <div id="loading" class="" style="float: left;">
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                    <td align="right">
                                        &nbsp;
                                    </td>
                                    <td align="right">
                                        <input alt="@Resources.Lang.exporttoexcel" src="@Url.Content("~/_GlobalResources/Images/excel.gif")"
                                            type="image" id="exporttoexcel" name="exporttoexcel" nofocus="true" title="@Resources.Lang.exporttoexcel"
                                            class="hand" />
                                    </td>
                                </tr>
                            </table>
                            <!--ReportTimeDisclaimer-->
                            <div class="warning l" style="margin-bottom: 5px; margin-top: -7px; padding: 0 2px;">
                                <ul>
                                    <li><span>@ViewBag.ReportTimeDisclaimerContent</span></li></ul>
                            </div>
                            <!--/ReportTimeDisclaimer-->
                        </div>
                    </td>
                </tr>
            }
            <!--/HeaderRegion-->
            <!--SportCriteria-->
            @if (ViewBag.IsVisibleSportCriteria == true)
            {
                <tr>
                    <td>
                        <table border="0">
                            <tr>
                                <td>
                                    @Resources.Lang.sport
                                </td>
                                <td id="selSport">
                                    <select name="ddlSport" id="ddlSport" style="position: relative;">
                                        <!--SportOption-->
                                        @Html.Raw(ViewBag.SportOption)
                                        <!--/SportOption-->
                                    </select>
                                </td>
                                <td width="10">
                                    &nbsp;
                                </td>
                                <td>
                                    @Resources.Lang.league
                                </td>
                                <td id="selLeague" name="selLeague">
                                    <select name="ddlLeague" id="ddlLeague">
                                        <option value='0' selected='selected'>*..::* Show All Leagues *::..*</option>
                                        <!--LeagueOption-->
                                        @Html.Raw(ViewBag.LeagueOption)
                                        <!--/LeagueOption-->
                                    </select>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            }
            <!--/SportCriteria-->
            <tr>
                <td>
                    <div id="tbl-container">
                        <div id="boderRight">
                            <!--ExcelContents-->
                            @Html.Raw(ViewBag.Result)
                            <!--/ExcelContents-->
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <input type="hidden" id="isOutright" name="isOutright" value="@Model.IsOutright.ToString()" />
    @Html.Hidden("RootURL", Url.Content("~/"))
    </form>
    <script src="@Url.Content("~/Js/jQuery/jquery-1.8.2.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/moment.js")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/_Components/DateTimeControl/JSCalendar/js/jscal2.js?06")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/_Components/DateTimeControl/JSCalendar/js/lang/en.js?06")" type="text/javascript"></script>
    @if (Model.MatchId > 0)
    {
        <script src="../../_GlobalResources/Js/Core.js" type="text/javascript"></script>
        <script src="../../_Components/AGEWnd/AGEWnd.js" type="text/javascript"></script>
    }
    else
    {
        <script type="text/javascript">
            var max_server_date = new Date().toString("MM/dd/yyyy");
            var minDate = moment('@ViewBag.MinReportDate', "MMDDYYYY");
            minDate = parseInt(minDate.format('YYYYMMDD'));

            var maxDate = moment('@DateTime.Now.ToShortDateString()', "MMDDYYYY");
            maxDate = parseInt(maxDate.format('YYYYMMDD'));

            var fromDate = '@Model.FromDate.Value.ToShortDateString()';
            var toDate = '@Model.ToDate.Value.ToShortDateString()';

            var fdate = Calendar.setup({
                animation: false,
                trigger: "fdate_trigger",
                inputField: "fromDate",
                min: minDate,
                max: maxDate,
                dateFormat: "%m/%d/%Y",
                weekNumbers: true,
                onSelect: function () {
                    this.hide();
                }
            });

            var tdate = Calendar.setup({
                animation: false,
                trigger: "tdate_trigger",
                inputField: "toDate",
                min: minDate,
                max: maxDate,
                dateFormat: "%m/%d/%Y",
                weekNumbers: true,
                onSelect: function () {
                    this.hide();
                }
            });
        </script> 
        <script src="@Url.Content("~/Areas/Report/Views/Result/Scripts/Result.js")" type="text/javascript"></script>
    }
</body>
</html>
