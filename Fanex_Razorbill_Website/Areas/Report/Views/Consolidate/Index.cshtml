@using Fanex.Razorbill.Module.Core.Extensions;
@using Fanex.Razorbill.Module.Common.Enums;
@using Fanex.Razorbill.Module.Common.Services;
@{
    Page.Title = "Title goes here";
    Layout = "../Shared/_Layout.cshtml";

    DateTime reportMinDate = (DateTime)ViewBag.ReportMinDate;
    string reportMinDateString = string.Format("{0:yyyyMMdd}", reportMinDate);
}
@section Head{
    <link href="@Url.Content("~/_Components/DateRangeSelect/DateRangeSelect.css")"
        rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/_Components/DateTimeControl/JSCalendar/css/jscal2.css?06")"
        rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/_Components/DateTimeControl/JSCalendar/css/steel/steel.css?06")"
        rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css")" rel="stylesheet" type="text/css" />
    @*<link href="@Url.Content("~/Content/Themes/Honolulu/less/home/style.less")"
        rel="stylesheet" type="text/css" />*@
    <link href="@Url.Content("~/Areas/Report/Views/Consolidate/Style/Consolidate.css?ver=3")" rel="stylesheet" type="text/css" />
}
@section Scripts {
    <script src="@Url.Content("~/_Components/DateRangeSelect/DateRangeSelect.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/_Components/DateTimeControl/JSCalendar/js/jscal2.js?06")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/_Components/DateTimeControl/JSCalendar/js/lang/en.js?06")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/moment.js")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/numeral.js")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/bootstrap/js/bootstrap.min.js")"
        type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/Report/Views/Consolidate/Scripts/Consolidate.js")" type="text/javascript"></script>
    <script type="text/javascript">
        var resources =
            {
                Level: "@Resources.Lang.level",
                UserName: "@Resources.Lang.username",
                Currency: "@Resources.Lang.currency",
                Turnover: "@Resources.Lang.turnover",
                WinLoss: "@Resources.Lang.lblWinLoss",
                Comm: "@Resources.Lang.com",
                Total: "@Resources.Lang.total",
                Company: "@Resources.Lang.company",
                BetCount: "@Resources.Lang.betcount",
                Member: "@Resources.Lang.member",
                Owner: "@Resources.Lang.owner",
                Daily: "@Resources.Lang.daily",
                Sport: "@Resources.Lang.sport",
                UserNameConsolidatedReport: "@Resources.Lang.usernameconsolidatedreport",
                DailyConsolidatedReport: "@Resources.Lang.dailyconsolidatedreport",
                SportConsolidatedReport: "@Resources.Lang.sportconsolidatedreport",
                GridNoDataText: "@Resources.Lang.noInfo",
                All: "@Resources.Lang.all",
                AllCurrencies: "@Resources.Lang.allcurrencies",
                ViewUnder: "@Resources.Lang.viewunder"
            };

        var max_server_date = new Date().toString("MM/dd/yyyy");
        var minDate = @reportMinDateString;
        function CalendarOnSelect() {
            if ($("ddlSelectDate"))
                $("ddlSelectDate").value = 8;
        }

        var fdate = Calendar.setup({
            animation: false,
            trigger: "fdate_trigger",
            inputField: "fdate",
            min: minDate,
            dateFormat: "%m/%d/%Y",
            weekNumbers: true,
            onSelect: function () {
                CalendarOnSelect();
                this.hide();
            }
        });

        var tdate = Calendar.setup({
            animation: false,
            trigger: "tdate_trigger",
            inputField: "tdate",
            min: minDate,
            dateFormat: "%m/%d/%Y",
            weekNumbers: true,
            onSelect: function () {
                CalendarOnSelect();
                this.hide();
            }
        });

    </script>
}
<form id="frmmain" method="get">
<div class="row-fluid">
    <div id="header_main" class="span36">
        @Resources.Lang.consolidationreport</div>
</div>
<div class="row-fluid">
    <div style="padding-left: 10px; padding-right: 10px;">
        <div id="box_header" class="span36">
            <div style="padding-left: 5px; padding-top: 5px;">
                <table width="100%">
                    <tr>
                        <td>
                            <div id="spDateTimeSearch">
                                <table cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td>
                                            <spa>@Resources.Lang.date :
                                                <select id="ddlSelectDate" name="ddlSelectDate" style="position: relative" onchange="ChangeDate(this);">
                                                    <optgroup label="@Resources.Lang.pleaseselect">
                                                        <option value="1" selected>@Resources.Lang.today</option>
                                                        <option value="2">@Resources.Lang.yesterday</option>
                                                        <option value="3">@Resources.Lang.currentweek</option>
                                                        <option value="4">@Resources.Lang.lastweek</option>
                                                        <option value="5">@Resources.Lang.currentmonth</option>
                                                        <option value="6">@Resources.Lang.lastmonth</option>
                                                        <option value="7">@Resources.Lang.sincelastmonth</option>
                                                        <option value="8">@Resources.Lang.specificdate</option>
                                                    </optgroup>
                                                </select>
                                            </span>
                                        </td>
                                        <td id="tdfdatetext" style="padding-left: 6px;" class="l">
                                            <span id="spfdatetext">@Resources.Lang.from:</span>
                                        </td>
                                        <td id="tdFromDateCal" class="l">
                                            <span id="spFromDateCal">
                                                <table cellpading="0" cellspacing="0" border="0">
                                                    <tr>
                                                        <td>
                                                            <input id="fdate" name="FromDate" class="date_no" value="06/14/2013" type="text"
                                                                size="13" name="fdate" readonly="readonly" />
                                                        </td>
                                                        <td>
                                                            <input type="image" alt="" src="@Url.Content("~/_GlobalResources/Images/cal.gif")"
                                                                        id="fdate_trigger" title="Date selector" style="margin: 0px; cursor: pointer"
                                                                        onclick="javascript:return false;" /><!-- <img alt="" src="/Fanex.Razorbill.Website/_GlobalResources/Images/cal.gif" id="fdate_trigger" title="Date selector"style="margin: 0px; cursor: pointer" /> -->
                                                        </td>
                                                    </tr>
                                                </table>
                                            </span>
                                        </td>
                                        <td id="tdtdatetext" class="l">
                                            &nbsp;&nbsp; <span id="sptdatetext">@Resources.Lang.to:</span>
                                        </td>
                                        <td id="tdToDateCal" class="l">
                                            <span id="spToDateCal">
                                                <table cellpading="0" cellspacing="0" border="0">
                                                    <tr>
                                                        <td>
                                                            <input id="tdate" name="ToDate" class="date_no" value="06/14/2013" type="text" size="13"
                                                                name="tdate" readonly="readonly" />
                                                        </td>
                                                        <td>
                                                            <input type="image" alt="" src="@Url.Content("~/_GlobalResources/Images/cal.gif")"
                                                                        id="tdate_trigger" title="Date selector" style="margin: 0px; cursor: pointer"
                                                                        onclick="javascript:return false;" /><!-- <img alt="" src="/Fanex.Razorbill.Website/_GlobalResources/Images/cal.gif" id="tdate_trigger" title="Date selector"style="margin: 0px; cursor: pointer" /> -->
                                                        </td>
                                                    </tr>
                                                </table>
                                            </span>
                                        </td>
                                        <td>
                                            <span style="padding-left: 5px">@Resources.Lang.currency :
                                                <select id="ddlCurrency" name="Currency" style="position: relative" onchange="ChangeCurrency();">
                                                </select></span>
                                        </td>
                                        <td class="l">
                                            &nbsp;&nbsp;<input type="button" class="btn" style="width: 55px" id="dSubmit" value="@Resources.Lang.submit"
                                                onclick="DisableButton();" />
                                        </td>
                                        <td valign="top">
                                            <div id="loading" class="" style="float: left;">
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                        <td align="right">
                            <input type="checkbox" id="chk_rpt_bold" name="BoldExcel" value="true" />
                            <label for="chk_rpt_bold" style="color: #999; text-transform: none; font-weight: bold;
                                line-height: 18px;">
                                @Resources.Lang.lblBold</label>&nbsp;
                            <input alt="@Resources.Lang.exporttoexcel" src="@Url.Content("~/_GlobalResources/Images/excel.gif")"
                                            type="image" id="exporttoexcel" name="exporttoexcel" nofocus="true" title="@Resources.Lang.exporttoexcel"
                                            class="hand" />
                        </td>
                    </tr>
                </table>
            </div>
            <div id="reportFilter" style="padding-left: 5px; padding-top: 5px;">
                <input type="checkbox" id="chk_all" value="true" name="chk_all" checked />
                <label for="chk_all">
                    @Resources.Lang.all</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showsb" value="true" name="ShowSB" checked />
                <label for="chk_showsb">
                    @Resources.Lang.SB</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showcasino" value="true" name="ShowCasino" checked />
                <label for="chk_showcasino">
                    @Resources.Lang.casino</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showrb" value="true" name="ShowRB" checked />
                <label for="chk_showrb">
                    @Resources.Lang.hr</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showng" value="true" name="ShowNG" checked />
                <label for="chk_showng">
                    @Resources.Lang.numbergame</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showbi" value="true" name="ShowBI" checked />
                <label for="chk_showbi">
                    @Resources.Lang.bingo</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showp2p" value="true" name="ShowP2P" checked />
                <label for="chk_showp2p">
                    @Resources.Lang.P2P</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showlivecasino" value="true" name="ShowLiveCasino"
                    checked />
                <label for="chk_showlivecasino">
                    @Resources.Lang.LiveCasino</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="checkbox" id="chk_showvs" value="true" name="ShowVS" checked />
                <label for="chk_showvs">
                    @Resources.Lang.VirtualSports</label>&nbsp;&nbsp;&nbsp;&nbsp;

                    @if(Sunplus.Agent.Model.Entities.Permission.UserPermission.EnableKeno){
                        <input type="checkbox" id="chk_showkeno" value="true" name="ShowKeno" checked />
                        <label for="chk_showvs">@Html.Raw(Resources.Lang.Keno)</label>
                    }
                <input type="hidden" name="FilterPostback" id="FilterPostback" value="postback" />
            </div>
            <div id="reportFilterByType" style="padding-left: 5px; padding-top: 5px;">
                @Resources.Lang.reportby&nbsp;
                <input id="rdbUserName" name="ReportType" value="1" type="radio" onclick="consolidationReportManager.GenerateData()"
                    checked />
                <label for="rdbUserName">
                    @Resources.Lang.username</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input id="rdbDaily" name="ReportType" value="2" type="radio" onclick="consolidationReportManager.GenerateData()" />
                <label for="rdbDaily">
                    @Resources.Lang.daily</label>&nbsp;&nbsp;&nbsp;&nbsp;
                <input id="rdbSport" name="ReportType" value="3" type="radio" onclick="consolidationReportManager.GenerateData()" />
                <label for="rdbSport">
                    @Resources.Lang.sport</label>
            </div>
            <div id="dvMsg" class="warning l" style="margin-bottom: 5px; margin-top: 10px; padding: 0 2px;">
                <ul>
                    <li>@string.Format(Resources.Lang.ViewDataFromDate, reportMinDate.ToShortFormatedDateWithSlash())</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row-fluid">
    <div style="padding-left: 10px; padding-right: 10px;">
        <div id="tbl-container" class="span36">
            <div id="boderRight">
                <div id="GridContainer" class="freegrid">
                </div>
            </div>
        </div>
    </div>
</div>
